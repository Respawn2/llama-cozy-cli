#!/usr/bin/env bash
# llama-cozy — a tiny, daemon-free launcher for llama.cpp
# Works the same from fish, bash, zsh, nushell… (it is a plain executable).
# Requires bash >= 4.4 (any current Linux distro). License: MIT

set -u
VERSION="0.2.0"
PROG="${0##*/}"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/llama-cozy"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/llama-cozy"
LAST_FILE="$STATE_DIR/last"

# ---------------------------------------------------------------- defaults
DEFAULT_PROMPT="You are a helpful, concise assistant. Give accurate, direct answers."
MODELS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/llama-cozy/models"
SYSTEM_PROMPT=$DEFAULT_PROMPT
CTX=4096
GPU_LAYERS=99
HOST=127.0.0.1
PORT=8080
BIN_DIR=""
EXTRA_ARGS=""
CONFIG_KEYS="MODELS_DIR SYSTEM_PROMPT CTX GPU_LAYERS HOST PORT BIN_DIR EXTRA_ARGS"

RESOLVED=""

# ---------------------------------------------------------------- helpers
info() { printf '%s\n' "$*" >&2; }
die()  { printf '❌ %s\n' "$*" >&2; exit 1; }

# NEW: colored output when stderr is a tty and NO_COLOR is unset
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_DIM=$'\033[2m'; C_RST=$'\033[0m'
else
    C_RED=""; C_GRN=""; C_YEL=""; C_DIM=""; C_RST=""
fi
ok()   { printf '%s✅%s %s\n' "$C_GRN" "$C_RST" "$*" >&2; }
warn() { printf '%s⚠️ %s%s\n' "$C_YEL" "$*" "$C_RST" >&2; }

load_config() {
    local k v
    if [ -f "$CONFIG_FILE" ]; then
        # Parsed, never sourced: a weird prompt can't execute anything.
        while IFS='=' read -r k v || [ -n "$k" ]; do
            case $k in ''|\#*) continue ;; esac
            v=${v:-}   # FIX: avoid unbound $v on `set -u` for lines without '='
            case " $CONFIG_KEYS " in *" $k "*) printf -v "$k" '%s' "$v" ;; esac
        done < "$CONFIG_FILE"
    fi
    # Backwards-compatible env overrides (the old version used these names)
    [ -n "${LLAMA_MODELS_DIR:-}" ] && MODELS_DIR=$LLAMA_MODELS_DIR
    [ -n "${LLAMA_PROMPT:-}" ] && SYSTEM_PROMPT=$LLAMA_PROMPT
    MODELS_DIR=${MODELS_DIR/#\~/$HOME}
    BIN_DIR=${BIN_DIR/#\~/$HOME}
}

bin() { if [ -n "$BIN_DIR" ]; then printf '%s/%s' "$BIN_DIR" "$1"; else printf '%s' "$1"; fi; }

need_bin() {
    local b; b=$(bin "$1")
    if command -v "$b" >/dev/null 2>&1; then return 0; fi
    # FIX: distinguish "BIN_DIR set but wrong" from "not installed"
    if [ -n "$BIN_DIR" ] && [ ! -d "$BIN_DIR" ]; then
        die "BIN_DIR is set to '$BIN_DIR' but that directory does not exist.
   Fix:  $PROG config set BIN_DIR /path/to/llama.cpp/build/bin
   Or:   $PROG config unset BIN_DIR"
    fi
    if [ -n "$BIN_DIR" ] && [ -d "$BIN_DIR" ] && [ ! -x "$b" ]; then
        die "'$1' not found in BIN_DIR ($BIN_DIR).
   Check the path, or:  $PROG config unset BIN_DIR"
    fi
    die "'$1' not found. Install llama.cpp (https://github.com/ggml-org/llama.cpp) or point me to it:  $PROG config set BIN_DIR /path/to/llama.cpp/build/bin"
}

hsize() { du -hL "$1" 2>/dev/null | cut -f1; }

quant_of() {
    # FIX: also match TQ*_* and MXFP4
    printf '%s' "$1" | grep -oiE '(IQ[0-9]_[A-Z0-9_]+|TQ[0-9]_[A-Z0-9_]+|Q[0-9]+_[A-Z0-9_]+|MXFP4|BF16|F16|F32)' | head -n1
}

remember() { mkdir -p "$STATE_DIR" && printf '%s\n' "$1" > "$LAST_FILE"; }

# All usable model files: no multimodal projectors, only the first part of split models
list_models() {
    [ -d "$MODELS_DIR" ] || return 0
    find -L "$MODELS_DIR" -type f -name '*.gguf' ! -iname '*mmproj*' 2>/dev/null \
        | grep -Ev -- '-0*([2-9]|[1-9][0-9]+)-of-[0-9]+\.gguf$' | sort
}

# Interactive chooser (fzf if present, numbered menu otherwise). Sets RESOLVED.
pick() {
    if [ ! -t 0 ] || [ ! -t 2 ]; then
        info "Several models match; be more specific:"
        printf '  %s\n' "${@##*/}" >&2
        exit 1
    fi
    local -a rel=(); local p choice n i=1
    for p in "$@"; do rel+=("${p#"$MODELS_DIR"/}"); done
    if command -v fzf >/dev/null 2>&1; then
        choice=$(printf '%s\n' "${rel[@]}" | fzf --prompt='model> ' --height=40% --reverse) || exit 130
    else
        for p in "${rel[@]}"; do printf '  %2d) %s\n' "$i" "$p" >&2; i=$((i + 1)); done
        read -r -p "Choose [1-${#rel[@]}]: " n || exit 130
        [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#rel[@]}" ] || die "Invalid choice"
        choice=${rel[n-1]}
    fi
    RESOLVED="$MODELS_DIR/$choice"
}

# Case-insensitive, all words must match. No words → last used model or chooser.
resolve_model() {
    local -a all=() hits=()
    local p b t ok
    mapfile -t all < <(list_models)
    [ ${#all[@]} -gt 0 ] || die "No .gguf models found in $MODELS_DIR
   • download one:  $PROG pull unsloth/Qwen3-8B-GGUF:Q4_K_M
   • or use an existing folder:  $PROG config set MODELS_DIR /path/to/models"

    if [ $# -eq 0 ]; then
        if [ -f "$LAST_FILE" ] && [ -f "$(cat "$LAST_FILE")" ]; then
            RESOLVED=$(cat "$LAST_FILE"); info "↻ Resuming last model"; return
        fi
        pick "${all[@]}"; return
    fi

    for p in "${all[@]}"; do
        b=${p##*/}; b=${b,,}; ok=1
        for t in "$@"; do [[ $b == *"${t,,}"* ]] || { ok=0; break; }; done
        [ $ok = 1 ] && hits+=("$p")
    done

    case ${#hits[@]} in
        0) die "No model matches '$*'. See: $PROG list" ;;
        1) RESOLVED=${hits[0]} ;;
        *)
            if [ $# -eq 1 ]; then       # an exact name wins over partial matches
                for p in "${hits[@]}"; do
                    b=${p##*/}; b=${b%.gguf}
                    [ "${b,,}" = "${1,,}" ] && { RESOLVED=$p; return; }
                done
            fi
            pick "${hits[@]}" ;;
    esac
}

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

# NEW: emit completion script for the requested shell
emit_completions() {
    case ${1:-} in
        bash) cat <<'BASH'
_llama_cozy() {
    local cur prev words cword
    _init_completion || return
    local subcmds="run chat list ls serve pull rm remove bench doctor config completions update ps stop show help version"
    if [ $cword -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$subcmds" -- "$cur") $(compgen -W "$(llama-cozy list --names 2>/dev/null)" -- "$cur") )
        return
    fi
    case ${words[1]} in
        run|chat|serve|rm|remove|bench|show)
            COMPREPLY=( $(compgen -W "$(llama-cozy list --names 2>/dev/null)" -- "$cur") )
            ;;
        list|ls)
            COMPREPLY=( $(compgen -W "--names --paths --fast" -- "$cur") )
            ;;
        config)
            if [ $cword -eq 2 ]; then
                COMPREPLY=( $(compgen -W "show path edit get set unset" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "MODELS_DIR SYSTEM_PROMPT CTX GPU_LAYERS HOST PORT BIN_DIR EXTRA_ARGS" -- "$cur") )
            fi
            ;;
        completions)
            COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
            ;;
        pull)
            COMPREPLY=( $(compgen -W "--list --dry-run" -- "$cur") )
            ;;
    esac
}
complete -F _llama_cozy llama-cozy
complete -F _llama_cozy ai
complete -F _llama_cozy ailist
BASH
        ;;
        zsh) cat <<'ZSH'
#compdef llama-cozy ai ailist
_llama_cozy() {
    local -a subcmds models
    subcmds=(run chat list ls serve pull rm remove bench doctor config completions update ps stop show help version)
    models=(${(f)"$(llama-cozy list --names 2>/dev/null)"})
    if (( CURRENT == 2 )); then
        _describe 'command' subcmds
        _describe 'model' models
        return
    fi
    case $words[2] in
        run|chat|serve|rm|remove|bench|show)
            _describe 'model' models ;;
        list|ls)
            _values 'flag' --names --paths --fast ;;
        config)
            if (( CURRENT == 3 )); then
                _values 'subcommand' show path edit get set unset
            else
                _values 'key' MODELS_DIR SYSTEM_PROMPT CTX GPU_LAYERS HOST PORT BIN_DIR EXTRA_ARGS
            fi ;;
        completions) _values 'shell' bash zsh fish ;;
        pull) _values 'flag' --list --dry-run ;;
    esac
}
_llama_cozy "$@"
ZSH
        ;;
        fish) cat <<'FISH'
function __llama_cozy_models
    llama-cozy list --names 2>/dev/null
end
complete -c llama-cozy -f
complete -c llama-cozy -n '__fish_use_subcommand' -a 'run chat list ls serve pull rm remove bench doctor config completions update ps stop show help version'
complete -c llama-cozy -n '__fish_use_subcommand' -a '(__llama_cozy_models)' -d 'Model'
complete -c llama-cozy -n '__fish_seen_subcommand_from run chat serve rm remove bench show' -a '(__llama_cozy_models)' -d 'Model'
complete -c llama-cozy -n '__fish_seen_subcommand_from run chat serve' -s c -l ctx -x -d 'Context size'
complete -c llama-cozy -n '__fish_seen_subcommand_from run chat' -s s -l system -x -d 'System prompt'
complete -c llama-cozy -n '__fish_seen_subcommand_from run chat' -s p -l prompt -x -d 'One-shot prompt'
complete -c llama-cozy -n '__fish_seen_subcommand_from run chat serve' -l cpu -d 'No GPU offload'
complete -c llama-cozy -n '__fish_seen_subcommand_from serve' -l port -x -d 'Port'
complete -c llama-cozy -n '__fish_seen_subcommand_from serve' -l host -x -d 'Host'
complete -c llama-cozy -n '__fish_seen_subcommand_from rm remove' -s y -l yes -d 'No confirmation'
complete -c llama-cozy -n '__fish_seen_subcommand_from config' -a 'show path edit get set unset'
