complete -c llama-cozy -n '__fish_seen_subcommand_from pull' -a '--list --dry-run'
# aliases used by installer
complete -c ai -w llama-cozy
complete -c ailist -w llama-cozy
FISH
        ;;
        *) die "Usage: $PROG completions <bash|zsh|fish>" ;;
    esac
}

# NEW: raw llama.cpp flags after --
split_run_opts() {
    # Sets: ctx sys prompt ngl and arrays terms/extra
    ctx=$CTX; ngl=$GPU_LAYERS; sys=$SYSTEM_PROMPT; prompt=""
    terms=(); extra=()
    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help)   usage_run; exit 0 ;;
            -c|--ctx)    ctx=${2:?"$1 needs a value"}; shift 2 ;;
            -s|--system) sys=${2:?"$1 needs a value"}; shift 2 ;;
            -p|--prompt) prompt=${2:?"$1 needs a value"}; shift 2 ;;
            --cpu)       ngl=0; shift ;;
            --)          shift; extra=("$@"); break ;;
            -*)          die "Unknown option '$1' (raw llama.cpp flags go after --)" ;;
            *)           terms+=("$1"); shift ;;
        esac
    done
}

usage_run() {
cat <<USAGE
Usage: $PROG run <model words…> [options]
Options:
  -c, --ctx N         context size (default: $CTX)
  -s, --system TEXT   system prompt for this session
  -p, --prompt TEXT   one-shot: answer and exit
      --cpu           don't offload to GPU
  --  …               pass raw flags straight to llama.cpp
USAGE
}

usage_serve() {
cat <<USAGE
Usage: $PROG serve <model words…> [options]
Options:
  -c, --ctx N         context size (default: $CTX)
      --port N        port (default: $PORT)
      --host ADDR     host (default: $HOST)
      --cpu           don't offload to GPU
  --  …               pass raw flags straight to llama-server
USAGE
}

# ---------------------------------------------------------------- commands
usage() {
cat <<USAGE
🦙 llama-cozy $VERSION — llama.cpp without the monster command lines

Usage:
  $PROG [model words…]            chat with a model (no words = last used / picker)
  $PROG run <model> [options]     same, with options (see below)
  $PROG list [--names|--paths]    show local models        (alias: ailist)
  $PROG show <model>              show path, size, quant, split parts
  $PROG serve <model>             OpenAI-compatible API + web UI (llama-server)
  $PROG pull <user/repo[:quant]>  download a GGUF from Hugging Face
  $PROG rm <model>                delete a model
  $PROG bench <model> [-- …]      quick speed benchmark (llama-bench)
  $PROG ps                        list running llama-cli/llama-server
  $PROG stop                      kill running llama-cli/llama-server
  $PROG doctor                    check the setup (GPU, llama.cpp, PATH…)
  $PROG config [show|set K V|get K|unset K|edit|path]
  $PROG completions <shell>       print completion script (bash|zsh|fish)
  $PROG update                    self-update from git (if cloned)

Model words are matched case-insensitively against file names:
  $PROG qwen 8b q4        → picks the one model containing all three words

run options:
  -c, --ctx N         context size (default: $CTX)
  -s, --system TEXT   system prompt for this session
  -p, --prompt TEXT   one-shot: answer and exit (stdin works too: echo hi | $PROG qwen)
      --cpu           don't offload to GPU
  --  …               pass raw flags straight to llama.cpp

Memory is released the moment you exit (Ctrl+C / Ctrl+D): nothing keeps running.
USAGE
}

cmd_list() {
    local mode=table fast=0 p b
    for a in "$@"; do
        case $a in
            --names) mode=names ;;
            --paths) mode=paths ;;
            --fast)  fast=1 ;;
        esac
    done
    local -a all=(); mapfile -t all < <(list_models)

    if [ $mode = names ]; then
        for p in "${all[@]}"; do b=${p##*/}; printf '%s\n' "${b%.gguf}"; done; return 0
    fi
    if [ $mode = paths ]; then
        [ ${#all[@]} -gt 0 ] && printf '%s\n' "${all[@]}"; return 0
    fi

    if [ ${#all[@]} -eq 0 ]; then
        info "📂 No models in $MODELS_DIR"
        info "   try:  $PROG pull unsloth/Qwen3-8B-GGUF:Q4_K_M"
        return 0
    fi
    printf '📂 %s\n' "$MODELS_DIR"
    for p in "${all[@]}"; do
        b=${p##*/}; b=${b%.gguf}
        if [ $fast = 1 ]; then
            printf '  • %-52s        %s\n' "$b" "$(quant_of "$b")"
        else
            printf '  • %-52s %6s  %s\n' "$b" "$(hsize "$p")" "$(quant_of "$b")"
        fi
    done
    printf '  %d model(s)\n' "${#all[@]}"
}

# NEW: show details for one model
cmd_show() {
    [ $# -ge 1 ] || die "Usage: $PROG show <model words…>"
    resolve_model "$@"
    local f=$RESOLVED b=${RESOLVED##*/} base=${RESOLVED##*/}
    base=${base%.gguf}
    printf 'model:   %s\n' "$base"
    printf 'path:    %s\n' "$f"
    printf 'size:    %s\n' "$(hsize "$f")"
    printf 'quant:   %s\n' "$(quant_of "$base")"
    # split parts?
    if [[ $f =~ ^(.*)-00001-of-([0-9]+)\.gguf$ ]]; then
        local stem=${BASH_REMATCH[1]} total=${BASH_REMATCH[2]}
        local -a parts=(); mapfile -t parts < <(compgen -G "${stem}-*-of-${total}.gguf")
        printf 'split:   %d part(s) of %s\n' "${#parts[@]}" "$total"
        local total_size=0 sz
        for p in "${parts[@]}"; do
            sz=$(stat -c %s "$p" 2>/dev/null || echo 0)
            total_size=$((total_size + sz))
        done
        printf 'total:   %s\n' "$(numfmt --to=iec --suffix=B "$total_size" 2>/dev/null || echo "$total_size bytes")"
    else
        printf 'split:   no (single file)\n'
    fi
    # modified time
    printf 'mtime:   %s\n' "$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null || echo unknown)"
    [ -f "$LAST_FILE" ] && [ "$(cat "$LAST_FILE")" = "$f" ] && printf 'last:    yes (resumed on bare `%s`)\n' "$PROG"
}

cmd_run() {
    local -a terms=() extra=() cfg_extra=() cmd=()
    split_run_opts "$@"

    need_bin llama-cli
    resolve_model "${terms[@]}"
    local model=$RESOLVED name=${RESOLVED##*/}
    # FIX: model may have disappeared between resolve and exec
    [ -f "$model" ] || die "Model disappeared: $model"
    remember "$model"
    [ -n "$EXTRA_ARGS" ] && read -r -a cfg_extra <<< "$EXTRA_ARGS"

    [ -z "$prompt" ] && [ ! -t 0 ] && prompt=$(cat)

    cmd=("$(bin llama-cli)" -m "$model" -ngl "$ngl" -c "$ctx")
    if [ -n "$prompt" ]; then
        cmd+=(-no-cnv --no-display-prompt -p "$prompt")
    elif [ -n "$sys" ]; then
        if "$(bin llama-cli)" --help 2>&1 | grep -q -- '--system-prompt'; then
            cmd+=(--system-prompt "$sys")
        else
            cmd+=(-cnv -p "$sys")
        fi
    fi

    info "🚀 ${name%.gguf}  (ctx $ctx, GPU layers $ngl)"
    exec "${cmd[@]}" "${cfg_extra[@]}" "${extra[@]}"
}

cmd_serve() {
    local -a terms=() extra=() cfg_extra=() cmd=()
    local ctx=$CTX ngl=$GPU_LAYERS host=$HOST port=$PORT
    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help) usage_serve; exit 0 ;;
            -c|--ctx)  ctx=${2:?"$1 needs a value"}; shift 2 ;;
            --port)    port=${2:?"$1 needs a value"}; shift 2 ;;
            --host)    host=${2:?"$1 needs a value"}; shift 2 ;;
            --cpu)     ngl=0; shift ;;
            --)        shift; extra=("$@"); break ;;
            -*)        die "Unknown option '$1' (raw flags go after --)" ;;
            *)         terms+=("$1"); shift ;;
        esac
    done
    need_bin llama-server
    resolve_model "${terms[@]}"
    local model=$RESOLVED name=${RESOLVED##*/}
    [ -f "$model" ] || die "Model disappeared: $model"
    remember "$model"
    [ -n "$EXTRA_ARGS" ] && read -r -a cfg_extra <<< "$EXTRA_ARGS"

    local tries=0
    while port_busy "$port" && [ $tries -lt 20 ]; do port=$((port + 1)); tries=$((tries + 1)); done
    info "🌐 http://$host:$port   (web UI at /, OpenAI-compatible API at /v1)"
    case $host in
        127.*|localhost) ;;
        *)
            # FIX: refuse to bind publicly without --api-key, unless user insists
            if ! printf '%s\n' "${extra[@]}" "${cfg_extra[@]}" | grep -q -- '--api-key'; then
                warn "Listening beyond localhost without auth."
                info "  add:  -- --api-key SECRET"
                if [ ! -t 0 ]; then
                    die "Refusing to bind publicly without --api-key (stdin not a tty)"
                fi
                read -r -p "Start anyway? [y/N] " a || exit 130
                [[ $a == [yY]* ]] || die "Aborted."
            fi
            ;;
    esac
    info "🚀 ${name%.gguf}  (ctx $ctx, GPU layers $ngl) — Ctrl+C stops the server and frees VRAM"
    exec "$(bin llama-server)" -m "$model" -ngl "$ngl" -c "$ctx" --host "$host" --port "$port" \
        --alias "${name%.gguf}" "${cfg_extra[@]}" "${extra[@]}"
}

cmd_bench() {
    need_bin llama-bench
    local -a terms=() extra=()
    while [ $# -gt 0 ]; do
        case $1 in
            -h|--help) cat >&2 <<USAGE
Usage: $PROG bench <model words…> [-- <llama-bench flags>]
USAGE
                exit 0 ;;
            --) shift; extra=("$@"); break ;;
            -*) die "Unknown option '$1' (raw llama-bench flags go after --)" ;;
            *)  terms+=("$1"); shift ;;
        esac
    done
    resolve_model "${terms[@]}"
    remember "$RESOLVED"
    exec "$(bin llama-bench)" -m "$RESOLVED" -ngl "$GPU_LAYERS" "${extra[@]}"
}

cmd_pull() {
    local list_only=0 dry=0 spec=""
    for a in "$@"; do
        case $a in
            --list|-l) list_only=1 ;;
            --dry-run|-n) dry=1 ;;
            -h|--help)
                cat >&2 <<USAGE
Usage: $PROG pull <user/repo>[:quant] [--list|--dry-run]
  --list      show available GGUF files in the repo
  --dry-run   show what would be downloaded
USAGE
                exit 0 ;;
            -*) die "Unknown option '$a'" ;;
            *)  spec=$a ;;
        esac
    done
    [ -n "$spec" ] || die "Usage: $PROG pull <user/repo>[:quant]   e.g. $PROG pull unsloth/Qwen3-8B-GGUF:Q4_K_M"
    command -v curl >/dev/null 2>&1 || die "curl is required for pull"
    local repo quant=Q4_K_M
    spec=${spec#https://huggingface.co/}
    repo=${spec%%:*}
    [[ $spec == *:* ]] && quant=${spec#*:}
    [[ $repo == */* ]] || die "Repo must look like user/name"

    local -a auth=(); [ -n "${HF_TOKEN:-}" ] && auth=(-H "Authorization: Bearer $HF_TOKEN")
    info "🔎 Looking up $repo …"
    local json
    json=$(curl -fsSL "${auth[@]}" "https://huggingface.co/api/models/$repo") \
        || die "Could not read $repo (typo, private or gated? set HF_TOKEN)"

    local -a files=() sel=() keys=()
    mapfile -t files < <(printf '%s' "$json" | grep -oE '"rfilename": *"[^"]+\.gguf"' | cut -d'"' -f4 | grep -vi mmproj)
    [ ${#files[@]} -gt 0 ] || die "No GGUF files in $repo"

    if [ $list_only = 1 ]; then
        printf '%s\n' "${files[@]}"
        return 0
    fi

    local f k
    for f in "${files[@]}"; do
        if [[ ${f,,} == *"${quant,,}"* ]]; then
            sel+=("$f")
            k=$(printf '%s' "$f" | sed 's/-[0-9]\{5\}-of-[0-9]\{5\}\.gguf$/.gguf/')
            [[ " ${keys[*]:-} " == *" $k "* ]] || keys+=("$k")
        fi
    done
    if [ ${#sel[@]} -eq 0 ]; then
        info "No file matches '$quant'. Available:"; printf '  %s\n' "${files[@]}" >&2; exit 1
    fi
    if [ ${#keys[@]} -gt 1 ]; then
        info "'$quant' is ambiguous, be more specific:"; printf '  %s\n' "${keys[@]}" >&2; exit 1
    fi

    local dest
    for f in "${sel[@]}"; do
        dest="$MODELS_DIR/$repo/$f"
        if [ -f "$dest" ]; then info "✔ already have ${f##*/}"; continue; fi
        if [ $dry = 1 ]; then info "would download: $f → $dest"; continue; fi
        mkdir -p "${dest%/*}"
        info "⬇️  ${f##*/}"
        curl -fL -C - --progress-bar "${auth[@]}" -o "$dest.part" \
            "https://huggingface.co/$repo/resolve/main/$f" || die "Download failed (re-run to resume)"
        mv "$dest.part" "$dest"
    done
    [ $dry = 1 ] || info "✅ Done. Try:  $PROG ${quant,,}"
}

cmd_rm() {
    local yes=0 a ans; local -a terms=()
    for a in "$@"; do case $a in -y|--yes) yes=1 ;; -*) die "Unknown option '$a'" ;; *) terms+=("$a") ;; esac; done
    [ ${#terms[@]} -gt 0 ] || die "Usage: $PROG rm <model> [-y]"
    resolve_model "${terms[@]}"
    local f=$RESOLVED; local -a victims=("$f")
    if [[ $f =~ ^(.*)-00001-of-([0-9]+)\.gguf$ ]]; then
        mapfile -t victims < <(compgen -G "${BASH_REMATCH[1]}-*-of-${BASH_REMATCH[2]}.gguf")
    fi
    printf '🗑  %s\n' "${victims[@]##*/}" >&2
    if [ $yes = 0 ]; then
        read -r -p "Delete? [y/N] " ans || exit 130
        [[ $ans == [yY]* ]] || { info "Cancelled."; return 0; }
    fi
    rm -f -- "${victims[@]}"
    [ -f "$LAST_FILE" ] && [ "$(cat "$LAST_FILE")" = "$f" ] && rm -f "$LAST_FILE"
    ok "Deleted."
}

cmd_config() {
    local sub=${1:-show}; [ $# -gt 0 ] && shift
    local k v tmp
    case $sub in
        show) for k in $CONFIG_KEYS; do printf '%-13s = %s\n' "$k" "${!k}"; done
              printf '\nfile: %s\n' "$CONFIG_FILE" ;;
        path) printf '%s\n' "$CONFIG_FILE" ;;
        get)  k=${1:?"Usage: $PROG config get KEY"}
              case " $CONFIG_KEYS " in *" $k "*) printf '%s\n' "${!k}" ;; *) die "Unknown key $k" ;; esac ;;
        unset) k=${1:?"Usage: $PROG config unset KEY"}
              case " $CONFIG_KEYS " in *" $k "*) ;; *) die "Unknown key '$k'" ;; esac
              [ -f "$CONFIG_FILE" ] || { info "No config file."; return 0; }
              tmp=$(mktemp "$CONFIG_DIR/.cfg.XXXXXX")
              grep -v "^$k=" "$CONFIG_FILE" > "$tmp" || true
              mv "$tmp" "$CONFIG_FILE"
              ok "$k unset" ;;
        edit) mkdir -p "$CONFIG_DIR"; touch "$CONFIG_FILE"; exec ${EDITOR:-${VISUAL:-vi}} "$CONFIG_FILE" ;;
        set)  k=${1:?"Usage: $PROG config set KEY VALUE"}; shift; v=$*; v=${v//$'\n'/ }
              case " $CONFIG_KEYS " in *" $k "*) ;; *) die "Unknown key '$k'. Keys: $CONFIG_KEYS" ;; esac
              mkdir -p "$CONFIG_DIR"
              tmp=$(mktemp "$CONFIG_DIR/.cfg.XXXXXX")
              [ -f "$CONFIG_FILE" ] && grep -v "^$k=" "$CONFIG_FILE" > "$tmp"
              printf '%s=%s\n' "$k" "$v" >> "$tmp"
              mv "$tmp" "$CONFIG_FILE"
              ok "$k = $v" ;;
        *)    die "Usage: $PROG config [show|get K|set K V|unset K|edit|path]" ;;
    esac
}

cmd_doctor() {
    local ok=0 b out gpu=""
    good() { printf '  %s✅%s %s\n' "$C_GRN" "$C_RST" "$*"; }
    warn() { printf '  %s⚠️ %s%s\n' "$C_YEL" "$*" "$C_RST"; ok=1; }
    echo "🩺 llama-cozy $VERSION"

    if [ -n "$BIN_DIR" ]; then
        if [ -d "$BIN_DIR" ]; then good "BIN_DIR: $BIN_DIR"
        else warn "BIN_DIR set but missing: $BIN_DIR"; fi
    fi

    for b in llama-cli llama-server; do
        if command -v "$(bin $b)" >/dev/null 2>&1; then good "$b → $(command -v "$(bin $b)")"
        else warn "$b not found (set BIN_DIR or install llama.cpp)"; fi
    done
    if command -v "$(bin llama-bench)" >/dev/null 2>&1; then good "llama-bench found"
    else info "  ·  llama-bench missing (only needed for '$PROG bench')"; fi

    if command -v "$(bin llama-cli)" >/dev/null 2>&1; then
        out=$("$(bin llama-cli)" --version 2>&1 | grep -iE 'cuda|vulkan|rocm|hip|metal|sycl|version' | head -n 3)
        [ -n "$out" ] && printf '     %s\n' "$out"
    fi

    if command -v nvidia-smi >/dev/null 2>&1; then
        gpu=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -n1)
        [ -n "$gpu" ] && good "NVIDIA GPU: $gpu"
    elif command -v rocm-smi >/dev/null 2>&1; then gpu=amd; good "AMD GPU (ROCm) detected"
    elif command -v vulkaninfo >/dev/null 2>&1; then gpu=vk; good "Vulkan device available"
    else info "  ·  no GPU tooling found — CPU mode (use --cpu, or: $PROG config set GPU_LAYERS 0)"; fi
    if [ -n "$gpu" ] && command -v "$(bin llama-cli)" >/dev/null 2>&1; then
        "$(bin llama-cli)" --version 2>&1 | grep -qiE 'cuda|vulkan|rocm|hip|sycl' \
            || warn "GPU found, but this llama.cpp build shows no GPU backend (rebuild with -DGGML_CUDA=ON / -DGGML_VULKAN=ON)"
    fi

    if [ -d "$MODELS_DIR" ]; then good "models dir: $MODELS_DIR ($(list_models | wc -l) models)"
    else warn "models dir missing: $MODELS_DIR  →  $PROG config set MODELS_DIR <path>"; fi

    if command -v curl >/dev/null 2>&1; then good "curl (for pull)"; else info "  ·  curl missing (only needed for 'pull')"; fi
    if command -v fzf  >/dev/null 2>&1; then good "fzf (nicer model picker)"; else info "  ·  fzf not installed (optional)"; fi

    # Old v0.1 leftovers shadow the new command in fish/bash
    [ -f "$HOME/.config/fish/functions/ai.fish" ] && warn "old fish function ~/.config/fish/functions/ai.fish shadows this command → re-run install.sh --migrate"
    [ -f "$HOME/.llama-cozy-env" ] && warn "old ~/.llama-cozy-env still exists → re-run install.sh --migrate"

    if [ $ok = 0 ]; then echo "All good 🎉"; else echo "Some things need attention ↑"; fi
    return $ok
}

# NEW: list running processes
cmd_ps() {
    local pat='llama-(cli|server)'
    if command -v pgrep >/dev/null 2>&1; then
        local pids; pids=$(pgrep -af "$pat" 2>/dev/null || true)
        if [ -z "$pids" ]; then info "No llama-cli/llama-server running."; return 0; fi
        printf '%-8s %s\n' "PID" "COMMAND"
        printf '%s\n' "$pids"
    else
        ps aux | grep -E "$pat" | grep -v grep || info "No llama-cli/llama-server running."
    fi
}

# NEW: stop running processes
cmd_stop() {
    local yes=0 a
    for a in "$@"; do case $a in -y|--yes) yes=1 ;; -h|--help) info "Usage: $PROG stop [-y]"; return 0 ;; *) die "Unknown option '$a'" ;; esac; done
    local pat='llama-(cli|server)'
    local pids
    if command -v pgrep >/dev/null 2>&1; then
        pids=$(pgrep -f "$pat" 2>/dev/null || true)
    else
        pids=$(ps -eo pid,args | grep -E "$pat" | grep -v grep | awk '{print $1}')
    fi
    [ -n "$pids" ] || { info "Nothing to stop."; return 0; }
    printf 'Will stop:\n' >&2
    ps -o pid,args -p $pids 2>/dev/null >&2 || true
    if [ $yes = 0 ]; then
        local ans; read -r -p "Stop these? [y/N] " ans || exit 130
        [[ $ans == [yY]* ]] || { info "Cancelled."; return 0; }
    fi
    # shellcheck disable=SC2086
    kill -TERM $pids 2>/dev/null || true
    sleep 1
    # force-kill leftovers
    for p in $pids; do kill -0 "$p" 2>/dev/null && kill -KILL "$p" 2>/dev/null || true; done
    ok "Stopped."
}

# NEW: self-update from git (if cloned)
cmd_update() {
    local src
    src=$(cd -- "$(dirname -- "$0")" && pwd)
    if [ -d "$src/.git" ]; then
        info "📦 git pull in $src"
        git -C "$src" pull --ff-only || die "git pull failed"
        ok "Updated. Re-run ./install.sh to refresh completions."
    else
        warn "Not a git checkout ($src)."
        info "  Update manually:  curl -fsSL <raw-url>/llama-cozy -o $0"
        info "  Or clone:         git clone <repo> && ./install.sh"
    fi
}

# ---------------------------------------------------------------- dispatch
main() {
    load_config
    if [ "$PROG" = ailist ]; then cmd_list "$@"; return; fi
    case ${1:-} in
        "")                    cmd_run ;;
        run|chat)              shift; cmd_run "$@" ;;
        list|ls)               shift; cmd_list "$@" ;;
        show)                  shift; cmd_show "$@" ;;
        serve)                 shift; cmd_serve "$@" ;;
        pull)                  shift; cmd_pull "$@" ;;
        rm|remove)             shift; cmd_rm "$@" ;;
        bench)                 shift; cmd_bench "$@" ;;
        ps)                    shift; cmd_ps "$@" ;;
        stop)                  shift; cmd_stop "$@" ;;
        doctor)                shift; cmd_doctor ;;
        config)                shift; cmd_config "$@" ;;
        completions)           shift; emit_completions "$@" ;;
        update)                shift; cmd_update "$@" ;;
        help|-h|--help)        usage ;;
        version|-V|--version)  echo "llama-cozy $VERSION" ;;
        *)                     cmd_run "$@" ;;
    esac
}
main "$@"